#!/usr/bin/env node

// Manual/ops escape hatch for on-demand geometry repair (e.g. after an iPlan outage
// or to run backfill on a separate cadence). The recurring geometry backfill now
// ALSO runs automatically as the geometry-backfill phase of bin/run_mavat_search /
// bin/iplan (via server/api/lib/crawlPipeline.js), so production does not need this
// bin to be scheduled. Keep this entry point for one-off repairs only.

const controller = require('../api/controller/cron');
const Log = require('../api/lib/log');
const { runAndReport } = require('../metrics');

runAndReport({
	func: async () => {
		const STARTED_AT = Date.now();
		Log.info('[run_iplan_geometry] Starting geometry fetch for plans missing geometry');

		const count = await controller.fetchIplanGeometry();
		const elapsed = ((Date.now() - STARTED_AT) / 1000).toFixed(1);
		Log.info(`[run_iplan_geometry] fetchIplanGeometry completed: ${count} plans updated in ${elapsed}s`);
	}, name: 'fetchIplanGeometry'
});
