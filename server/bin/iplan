#!/usr/bin/env node

// bin/iplan is the production crontab entry point (`*/40 * * * * ... bin/iplan`, see
// README.md). It runs the same mavatSearch crawl + geometry-backfill pipeline as
// bin/run_mavat_search (the logic lives in api/lib/crawlPipeline.js), so production
// gets the incremental crawler AND self-healing geometry backfill in the single
// scheduled run. bin/run_mavat_search is the canonical entry point for new scheduling.

const { runMavatSearchCrawl } = require('../api/lib/crawlPipeline');
const { runAndReport } = require('../metrics');

runAndReport({
	func: runMavatSearchCrawl,
	name: 'iplan'
});